{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cograph",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-27",
  "assets": {
    "not_found_handling": "single-page-application",
    // Without this the SPA fallback can answer /api/* before the Worker sees it.
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "RoomDurableObject" },
      { "name": "DIRECTORY", "class_name": "RoomsDirectoryDurableObject" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RoomDurableObject"] },
    { "tag": "v2", "new_sqlite_classes": ["RoomsDirectoryDurableObject"] }
  ],
  "observability": { "enabled": true }
}
